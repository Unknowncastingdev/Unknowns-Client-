<Project>
  <!--
    Keep NuGet restore and compilation on exactly the same intermediate path.
    These properties must be defined BEFORE Microsoft.NET.Sdk/Sdk.props is imported.
  -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(MSBuildProjectDirectory)\obj\</MSBuildProjectExtensionsPath>
    <RestoreOutputPath>$(MSBuildProjectDirectory)\obj\</RestoreOutputPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Unknowns Client</AssemblyName>
    <RootNamespace>UnknownsCastingUI</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <RestoreAdditionalProjectSources>https://api.nuget.org/v3/index.json</RestoreAdditionalProjectSources>
    <ProjectAssetsFile>$(MSBuildProjectExtensionsPath)project.assets.json</ProjectAssetsFile>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <CameraEdition Condition="'$(CameraEdition)' == ''">Plus</CameraEdition>
    <DefineConstants Condition="'$(CameraEdition)' == 'Basic'">$(DefineConstants);UNKNOWNS_BASIC</DefineConstants>
    <DefineConstants Condition="'$(CameraEdition)' == 'Utility'">$(DefineConstants);UNKNOWNS_UTILITY</DefineConstants>
    <DefineConstants Condition="'$(CameraEdition)' == 'Plus'">$(DefineConstants);UNKNOWNS_PLUS</DefineConstants>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    
    <!-- Path to Gorilla Tag installation -->
    <GorillaTagPath Condition="'$(GorillaTagPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Gorilla Tag</GorillaTagPath>
    <ManagedPath Condition="'$(ManagedPath)' == ''">$(GorillaTagPath)\Gorilla Tag_Data\Managed</ManagedPath>

    <!-- Direct SharpMono build: no BepInEx dependency. Harmony is resolved from the single-file Lib.Harmony package. -->
  </PropertyGroup>

