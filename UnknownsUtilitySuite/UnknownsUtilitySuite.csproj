<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>UnknownsUtilitySuite</AssemblyName>
    <RootNamespace>UnknownsUtilitySuite</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runtime UI integration is linked into UnknownsClient.csproj so SharpMono stays single-DLL. -->
    <Compile Remove="Runtime\UtilityAddonPanel.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
